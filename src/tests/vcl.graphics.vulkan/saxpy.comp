#version 450
#extension GL_EXT_nonuniform_qualifier : require

// Defines the size of the work-group (specialization constants)
layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout(push_constant) uniform Parameters
{
	// Total width
	uint Width;

	// Total height
	uint Height;

	// Saxpy scale 'a'
	float a;

	// Index of the array 'x' in the resource heap
	uint X;

	// Index of the array 'y' in the resource heap
	uint Y;
} params;

// Bindless resource heap
layout(std430, set = 0, binding = 0) buffer FloatArray { float data[]; } Buffers[];

void main()
{
   if (params.Width <= gl_GlobalInvocationID.x || params.Height <= gl_GlobalInvocationID.y)
   {
      return;
   }

   const uint idx = params.Width*gl_GlobalInvocationID.y + gl_GlobalInvocationID.x;
   Buffers[params.Y].data[idx] += params.a * Buffers[params.X].data[idx];
}
