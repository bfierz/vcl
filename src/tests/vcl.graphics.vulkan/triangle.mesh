#version 450
#extension GL_EXT_mesh_shader : require

// Triangle covering the upper-left half of the viewport, in the colour
// given by the push constants
layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;

layout(push_constant) uniform Parameters
{
	vec4 Colour;
} params;

layout(location = 0) out PerVertexData
{
	vec3 Colour;
} Out[];

void main()
{
	SetMeshOutputsEXT(3, 1);

	gl_MeshVerticesEXT[0].gl_Position = vec4(-1, -1, 0, 1);
	gl_MeshVerticesEXT[1].gl_Position = vec4( 1, -1, 0, 1);
	gl_MeshVerticesEXT[2].gl_Position = vec4(-1,  1, 0, 1);
	for (int i = 0; i < 3; i++)
		Out[i].Colour = params.Colour.rgb;

	gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}
