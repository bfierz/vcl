@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The dependencies are looked up through find_package only; they come from wherever the
# consumer got them (Conan, a system package, a parent project).
find_dependency(Eigen3 CONFIG)
find_dependency(absl CONFIG)
find_dependency(fmt CONFIG)
find_dependency(meshoptimizer CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/vclTargets.cmake")

check_required_components(vcl)
