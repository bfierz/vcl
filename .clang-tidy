---
# The curated check set (docs/adr/0002-cpp17-idioms-enforced-by-clang-tidy.md), for clang-tidy 18.
# A check is only added once the whole tree passes it. WarningsAsErrors repeats the list.
Checks: >
    -*,
    modernize-avoid-bind,
    modernize-concat-nested-namespaces,
    modernize-deprecated-headers,
    modernize-deprecated-ios-base-aliases,
    modernize-loop-convert,
    modernize-make-shared,
    modernize-make-unique,
    modernize-redundant-void-arg,
    modernize-replace-auto-ptr,
    modernize-replace-random-shuffle,
    modernize-shrink-to-fit,
    modernize-type-traits,
    modernize-unary-static-assert,
    modernize-use-auto,
    modernize-use-bool-literals,
    modernize-use-emplace,
    modernize-use-equals-default,
    modernize-use-equals-delete,
    modernize-use-noexcept,
    modernize-use-nullptr,
    modernize-use-override,
    modernize-use-transparent-functors,
    modernize-use-uncaught-exceptions,
    modernize-use-using
WarningsAsErrors: >
    modernize-avoid-bind,
    modernize-concat-nested-namespaces,
    modernize-deprecated-headers,
    modernize-deprecated-ios-base-aliases,
    modernize-loop-convert,
    modernize-make-shared,
    modernize-make-unique,
    modernize-redundant-void-arg,
    modernize-replace-auto-ptr,
    modernize-replace-random-shuffle,
    modernize-shrink-to-fit,
    modernize-type-traits,
    modernize-unary-static-assert,
    modernize-use-auto,
    modernize-use-bool-literals,
    modernize-use-emplace,
    modernize-use-equals-default,
    modernize-use-equals-delete,
    modernize-use-noexcept,
    modernize-use-nullptr,
    modernize-use-override,
    modernize-use-transparent-functors,
    modernize-use-uncaught-exceptions,
    modernize-use-using
# All of src/ except the third-party code clang-format skips as well: 3rdparty/,
# simd/detail/, math/mcadams/ and tests/vcl.geometry/ref/. clang-tidy 18 has no exclude
# filter and its regex has no lookahead, so the repeated group spells out "a directory
# that is not named 3rdparty, detail, mcadams or ref": each branch follows one of these
# names as far as it matches, then requires a different character or a longer name.
# Those directory names occur nowhere else in src/.
HeaderFilterRegex: '/src/(benchmarks|examples|libs|tests|tools)/(([^/3dmr][^/]*|3([^/r][^/]*|r([^/d][^/]*|d([^/p][^/]*|p([^/a][^/]*|a([^/r][^/]*|r([^/t][^/]*|t([^/y][^/]*|y[^/]+)?)?)?)?)?)?)?|d([^/e][^/]*|e([^/t][^/]*|t([^/a][^/]*|a([^/i][^/]*|i([^/l][^/]*|l[^/]+)?)?)?)?)?|m([^/c][^/]*|c([^/a][^/]*|a([^/d][^/]*|d([^/a][^/]*|a([^/m][^/]*|m([^/s][^/]*|s[^/]+)?)?)?)?)?)?|r([^/e][^/]*|e([^/f][^/]*|f[^/]+)?)?)/)*[^/]+$'
CheckOptions:
  - key:               modernize-use-nullptr.NullMacros
    value:             'NULL'
...
