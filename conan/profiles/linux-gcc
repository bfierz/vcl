# Linux, native gcc. Pass the build type on the command line: -s build_type=Release
include(default)

[settings]
compiler.cppstd=17
# Dawn needs C++20 to build; VCL only uses its C API (webgpu.h)
dawn/*:compiler.cppstd=20
compiler.libcxx=libstdc++11

[options]
&:with_opengl=True
&:with_egl=True

[buildenv]
# spirv-cross/cci.20211113 (newest on ConanCenter) declares CMake < 3.5, which CMake 4 rejects
CMAKE_POLICY_VERSION_MINIMUM=3.5

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
