# Windows, MSVC (Visual Studio 2022). Pass the build type on the command line:
#   -s build_type=Release
[settings]
os=Windows
arch=x86_64
compiler=msvc
compiler.version=194
compiler.runtime=dynamic
compiler.cppstd=17
# Dawn needs C++20 to build; VCL only uses its C API (webgpu.h)
dawn/*:compiler.cppstd=20

[options]
&:with_opengl=True
&:with_d3d12=True

[buildenv]
# spirv-cross/cci.20211113 (newest on ConanCenter) declares CMake < 3.5, which CMake 4 rejects
CMAKE_POLICY_VERSION_MINIMUM=3.5

[conf]
tools.cmake.cmaketoolchain:generator=Visual Studio 17 2022
